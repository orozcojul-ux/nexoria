  "craft.guide.tips": {
    "fr": "Bon à savoir",
    "en": "Good to know"
  },
  "craft.guide.intro": {
    "fr": "La Forge du Nexus transforme vos matériaux en reliques. Chaque tentative coûte des ressources et des Écus. Le résultat dépend du taux de réussite de la recette.",
    "en": "The Nexus Forge transforms your materials into relics. Each attempt costs resources and Écus. The outcome depends on the recipe's success rate."
  },
  "craft.guide.step0": {
    "fr": "Vérifiez vos ressources en haut de page et votre solde d'Écus.",
    "en": "Check your resources at the top and your Écus balance."
  },
  "craft.guide.step1": {
    "fr": "Choisissez une recette : les lignes rouges indiquent les matériaux manquants.",
    "en": "Choose a recipe: red lines indicate missing materials."
  },
  "craft.guide.step2": {
    "fr": "Consultez le taux de réussite (%) affiché sur la carte.",
    "en": "Check the success rate (%) shown on the card."
  },
  "craft.guide.step3": {
    "fr": "Cliquez sur « Forger » — le serveur valide tout côté backend.",
    "en": "Click « Craft » — the server validates everything on the backend."
  },
  "craft.guide.step4": {
    "fr": "Succès : l'objet apparaît dans votre Inventaire (onglet Reliques).",
    "en": "Success: the item appears in your Inventory (Relics tab)."
  },
  "craft.guide.step5": {
    "fr": "Échec : ressources et Écus sont consommés ; vous recevez 2× Poussière cosmique en compensation.",
    "en": "Failure: resources and Écus are consumed; you receive 2× Cosmic dust as compensation."
  },
  "craft.guide.tip0": {
    "fr": "Les matériaux obtenus en combat ou à la roue sont aussi visibles dans l'Inventaire (type matériau).",
    "en": "Materials from combat or the wheel are also visible in Inventory (material type)."
  },
  "craft.guide.tip1": {
    "fr": "L'historique en bas de page liste vos dernières tentatives.",
    "en": "History at the bottom lists your recent attempts."
  },
  "craft.guide.tip2": {
    "fr": "Certaines recettes ont un délai entre deux forgements (cooldown).",
    "en": "Some recipes have a cooldown between forges."
  },
  "craft.guide.tip3": {
    "fr": "Tout est calculé côté serveur : impossible de forger sans ressources ou Écus suffisants.",
    "en": "Everything is server-side: you cannot forge without enough resources or Écus."
  },
  "craft.guide.tip4": {
    "fr": "Progression : paliers (Apprenti → Grand Maître), badges forge et quêtes quotidiennes/hebdo/mensuelles.",
    "en": "Progression: tiers (Apprentice → Grand Master), forge badges and daily/weekly/monthly quests."
  },
  "craft.guide.tip5": {
    "fr": "Les paliers récompensent Écus, XP et badges — consultez la section « Paliers & récompenses » sur /craft.",
    "en": "Tiers reward Écus, XP and badges — see « Tiers & rewards » on /craft."
  },
