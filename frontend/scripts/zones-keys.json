  "craft.guide.failNote": {
    "fr": "En cas d'échec, ressources et Écus sont perdus. Compensation : 2× Poussière cosmique.",
    "en": "On failure, resources and Écus are lost. Compensation: 2× Cosmic dust."
  },
  "craft.guide.sources": {
    "fr": "Où obtenir les ressources",
    "en": "Where to get resources"
